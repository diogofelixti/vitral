# Optional: without a .env the panel is served on port 8080 and needs nothing else.

# Port the panel is served on, in your browser.
VITRAL_PORT=8080

# The Google credentials belong in Settings → Calendars (docs/google-calendar.md).
# Set here, they are imported once, on the first start, and ignored after that;
# this is only for an install that already had them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The api only answers requests addressed to an IP, "localhost", a bare
# local name (e.g. "raspberrypi") or one under .local/.lan/.home.arpa/
# .internal -- anything else is refused, to stop a public page from
# reaching the panel through a rebound DNS name. If you reach the panel
# by another name (a real domain, a custom local DNS entry), list it here,
# comma-separated. Leave empty if a local name already covers your setup.
PANEL_HOSTS=
